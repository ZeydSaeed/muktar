; Portable PHP ini for the bundled desktop runtime.
display_errors=Off
display_startup_errors=Off
error_reporting=E_ALL & ~E_DEPRECATED & ~E_STRICT
memory_limit=256M
max_execution_time=120
max_input_time=120
post_max_size=20M
upload_max_filesize=20M
date.timezone=Asia/Baghdad
default_charset=UTF-8
expose_php=Off

extension_dir="./ext"
extension=curl
extension=fileinfo
extension=gd
extension=intl
extension=mbstring
extension=openssl
extension=pdo_sqlite
extension=sqlite3
extension=zip
extension=exif
extension=sodium
extension=ftp
extension=soap

opcache.enable=1
opcache.enable_cli=1
opcache.memory_consumption=64
opcache.interned_strings_buffer=8
opcache.max_accelerated_files=10000
